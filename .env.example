# ─────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_BOT_CHAT_ID=                # From @BotFather
TELEGRAM_WEBHOOK_SECRET=             # Random string (min 16 chars) — set on setWebhook registration
TELEGRAM_WEBHOOK_URL=                # Public HTTPS base URL (production only, e.g. https://yourdomain.com)

# ─────────────────────────────────────────────
# OpenRouter
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=                  # From openrouter.ai/keys

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=file:./dev.db            # SQLite: file:./dev.db  |  PostgreSQL: postgresql://user:pass@host:5432/db

# ─────────────────────────────────────────────
# Agent Behavior
# ─────────────────────────────────────────────
MODEL_ID=deepseek/deepseek-r1        # OpenRouter model ID
MODEL_CONTEXT_WINDOW_TOKENS=128000   # Max context window for the selected model
MAX_TOOL_ROUNDS=10                   # Max tool call iterations per agent loop
REASONING_ENABLED=true               # Enable reasoning/thinking blocks (for supported models)
SYSTEM_PROMPT=You are a helpful AI assistant. Be concise, accurate, and thoughtful.

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
MAX_DAILY_REQUESTS_PER_USER=100      # Max requests per whitelisted user per day
MIN_REQUEST_INTERVAL_MS=3000         # Minimum milliseconds between requests from one user

# ─────────────────────────────────────────────
# Session Lifecycle
# ─────────────────────────────────────────────
IDLE_TIMEOUT_HOURS=24                # Hours of inactivity before a session auto-expires

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
LOG_LEVEL=info                       # trace | debug | info | warn | error
SENTRY_DSN=                          # Optional — leave blank to disable error tracking

# ─────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development                 # development | production

# ─────────────────────────────────────────────
# Tavily (optional — enables web search tools)
# ─────────────────────────────────────────────
TAVILY_API_KEY=                      # From app.tavily.com — tvly-...
