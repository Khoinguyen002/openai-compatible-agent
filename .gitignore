node_modules
dist/

# Override global gitignore — track .agents/ in this project
!.agents
!.agents/


# Database files
dev.db
*.db
*.sqlite
*.sqlite3
*-journal

# Env files
.env
.env.local
*.env

# Workspace dynamic directories
workspace/skills/cron/declaration.json
workspace/skills/tools/declaration.json
workspace/skills/tools/implementations/*

# Agent logs (outside workspace to prevent AI from reading)
logs/

# Exported conversation data (for prompt optimization — never commit)
exports/

# Prisma migrations (only track init)
prisma/migrations/*/
!prisma/migrations/0001_init/

# OS and Logs
.DS_Store
*.log
npm-debug.log*
