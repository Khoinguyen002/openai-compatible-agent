# ==========================================
# 🤖 ORCHESTRATOR (telegram-bot)
# ==========================================
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_BOT_CHAT_ID=                # Your personal Telegram chat ID
TELEGRAM_WEBHOOK_SECRET=             # Random string (min 16 chars)
TELEGRAM_WEBHOOK_URL=                # Public HTTPS base URL
DATABASE_URL=file:prisma/dev.db

# ==========================================
# 🧠 LLM ENGINE & ROUTING
# ==========================================
OPENROUTER_API_KEY=                  # From openrouter.ai/keys
MODEL_ID=deepseek/deepseek-r1        # OpenRouter model ID
MODEL_CONTEXT_WINDOW_TOKENS=128000   
MAX_TOOL_ROUNDS=10                   
REASONING_ENABLED=true               
SYSTEM_PROMPT=You are a helpful AI assistant. Be concise, accurate, and thoughtful.

# ==========================================
# 🔌 MCP SERVER: DOC-MCP (Google Drive)
# ==========================================
DOC_MCP_DRIVE_FOLDER_ID=             # Google Drive folder ID to index
DOC_MCP_GOOGLE_CLIENT_EMAIL=         # Google Cloud Service Account Email
DOC_MCP_GOOGLE_PRIVATE_KEY=          # Google Cloud Service Account Private Key (keep newlines as \n)

# ==========================================
# 🔌 MCP SERVER
# ==========================================
TAVILY_API_KEY=                      # From app.tavily.com
FIRECRAWL_API_KEY=                   

# ==========================================
# Rate Limiting & Session
# ==========================================
MAX_DAILY_REQUESTS_PER_USER=100
MIN_REQUEST_INTERVAL_MS=3000
IDLE_TIMEOUT_HOURS=24

# ==========================================
# Observability & Runtime
# ==========================================
LOG_LEVEL=info
SENTRY_DSN=
PORT=3000
NODE_ENV=development
