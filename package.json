{
  "name": "openrouter-telegram-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Stateful Telegram AI Agent Engine via OpenRouter Agent SDK",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm -r run build",
    "start": "pnpm --filter @workspace/telegram-bot start",
    "dev": "pnpm --filter @workspace/telegram-bot dev",
    "export": "pnpm --filter @workspace/telegram-bot export",
    "analyze": "pnpm --filter @workspace/telegram-bot analyze",
    "setup": "cp -n .env.example .env && echo 'Created .env — fill in your values before running the app'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^8.0.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.6.1",
    "googleapis": "^173.0.0",
    "grammy": "^1.31.0",
    "node-cron": "^4.2.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.19.19",
    "prisma": "^7.8.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
